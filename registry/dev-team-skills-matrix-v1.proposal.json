  "objective": "Crear un pack propio y completo de Agent Skills para Dev Team 2.3.0, con procedimientos de MCP, políticas de proyecto/equipo, desarrollo por dominio, UX/UI, calidad, seguridad y revisión; cada skill es advisory-only y cada agente recibe una allowlist exacta por nombre.",
  "kilo_semantics": {
    "discovery": "Kilo descubre metadata de skills y carga SKILL.md bajo demanda mediante la tool skill.",
    "permissions": "La tool skill pide permiso con pattern igual al nombre de la skill; se puede usar wildcard deny + allow exacto por skill.",
    "mode_specific_directories": false,
    "global_pool": true,
    "shell_injection_risk": "Skills trusted globales pueden contener !`command`; requieren aprobación humana. Wave S1 prohíbe shell injection embebido.",
    "activation_requires_reload": true
  },
  "invariants": [
    "No cambiar kilo.jsonc para activar esta propuesta.",
    "No cambiar permisos edit/write/apply_patch/bash/task/MCP por habilitar skills.",
    "Una skill nunca concede permisos que el agente no tenga.",
    "No usar skill: allow global; cada agente usa wildcard deny + allow exacto por nombre.",
    "No permitir skills que contradigan el contrato del rol sin adaptación previa.",
    "No activar skills con shell injection embebido en Wave S1.",
    "No promover una wave a runtime PASS solo por CI; requiere sync/reload y smoke real.",
    "Cambiar permission.skill invalida la certificación runtime solo del agente afectado y exige recertificación dirigida."
  ],
  "activation_policy": {
    "requires_explicit_operator_approval": true,
    "modifies_runtime_acl": true,
    "modifies_shared_skill_pool": true,
    "full_runtime_recertification_required": true,
    "no_auto_install": true,
    "no_kilo_jsonc_change": true,
    "current_runtime_changes": "NONE"
  },
  "installer_strategy": {
    "current_behavior": "Instalar-DevTeam-Only.ps1 currently treats all vx-* skill directories as legacy and removes them.",
    "target_behavior": "When Phase 1 is approved, manage exactly the 18 Dev Team skills from runtime/dev-team-v2r/skills under ~/.kilo/skills; every other vx-* skill remains legacy.",
    "managed_runtime_root": "~/.kilo/skills",
    "source_root": "runtime/dev-team-v2r/skills",
    "compatibility_roots": [
      "~/.agents/skills",
      "~/.kilocode/skills"
    ],
    "compatibility_policy": "No Dev Team pack is installed into compatibility roots.",
    "backup_restore": "All managed skill targets plus removed legacy directories are included in the same manifest-backed backup/rollback.",
    "config_preservation": "kilo.jsonc must remain byte-identical.",
    "install_requires": "explicit -Modo Aplicar after source CI, simulation, backup gates and operator approval"
  },
  "research_basis": {
    "status": "COMPLETED_SOURCE_SYNTHESIS",
    "principles": [
      "Agent Skills usa progressive disclosure: metadata al descubrir, SKILL.md al activar, recursos solo cuando hacen falta.",
      "Descripción específica y evals positivos/negativos son esenciales para triggering fiable.",
      "Permisos pertenecen al host/agente, no a la skill; no usar allowed-tools experimental como autoridad.",
      "MCP se trata como frontera de confianza: least privilege, consentimiento, schemas/tool metadata/output como datos no confiables.",
      "Cambios pequeños, CI y revisión independiente reducen riesgo de integración.",
      "UX/UI se revisa con accesibilidad WCAG 2.2, estados completos, responsive y métricas de experiencia medidas.",
      "El pack debe ser original y versionado; repos externos se usan como referencias de patrones, no como fuente copiada."
    ],
    "primary_sources": [
