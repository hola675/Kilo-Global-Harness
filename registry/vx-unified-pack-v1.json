    "team_coordination": {
      "schema": "vx-team-task-ledger/1",
      "owner": "vx-dev-team",
      "ledger_location": "LEADER_SESSION_ONLY_UNLESS_EXPLICIT_USER_AUTHORIZATION",
      "phase_statuses": [
        "PENDING",
        "RUNNING",
        "DELIVERED",
        "INTEGRATING",
        "VERIFIED",
        "BLOCKED",
        "FAILED"
      ],
      "task_contract": [
        "task_id",
        "owner",
        "allowed_paths",
        "depends_on",
        "base_sha_or_unborn",
        "contract_version",
        "acceptance",
        "evidence"
      ],
      "max_background_tasks": 4,
      "max_parallel_writers": 2,
      "shared_worktree_files": "EXACT_DISJOINT_ONLY",
      "git_ops_concurrency": "ONE_PER_WORKTREE",
      "no_cross_agent_task_stealing": true,
      "barrier_before_shared_files": true,
      "scope_permissions": "R0_READ_R1_SCOPED_CODE_R2_GIT_R3_EXPLICIT_HIGH_RISK",
      "runtime_enforcement": "NOT_IMPLEMENTED_PLAN_ONLY",
      "file_lease_runtime_enforced": false,
      "background_runtime_certified": false,
      "progress_protocol": {
        "schema": "vx-progress-event/1",
        "version": "1.0.0",
        "status": "SOURCE_CONTRACT_ONLY_BOARD_DENIED",
        "events": [
          "STARTED",
          "CONTRACT_READY",
          "MILESTONE",
          "BLOCKED",
          "DELIVERED",
          "CORRECTION"
        ],
        "verified_emitter": "vx-dev-team only after tool trace and diff/test verification",
        "event_fields": [
          "task_id_or_local_ref",
          "owner_agent",
          "contract_version",
          "event",
          "work_scope",
          "summary",
          "next_or_blocker",
          "evidence_ref",
          "verification_state"
        ],
        "leader_ledger": "SESSION_ONLY",
        "board_channel": "KILO_SWARM_IF_HOST_EXPOSES_AND_ACL_ALLOWS",
        "current_leader_board_acl": "DENY",
        "fallback": "TASK_RESULT",
        "allow_real_time_claim_without_board": false,
        "agent_manager_cross_session_board_shared": false,
        "board_is_authorization": false,
        "board_post_is_delivery_proof": false,
        "no_periodic_polling": true,
        "no_secrets_or_private_data": true,
        "no_new_agents": true,
        "no_new_skills": true,
        "runtime_background_certified": false,
        "runtime_board_certified": false
      }
