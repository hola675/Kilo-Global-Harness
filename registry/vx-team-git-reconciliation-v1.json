{
  "schema": "vx-team-git-reconciliation/1",
  "version": "1.2.0",
  "updated": "2026-11-19",
  "status": "SOURCE_PLAN_ONLY_RUNTIME_NOT_ACTIVATED",
  "documentation": "docs/VX-TEAM-GIT-RECONCILIATION-V1.md",
  "scope": "authorized_repositories_only",
  "permanent_branch": "main",
  "temporary_branch_prefix": "work/",
  "concurrency": {
    "multiple_independent_task_branches": true,
    "one_writer_per_worktree": true,
    "one_owner_per_branch": true,
    "main_write_by_PR_after_review": true
  },
  "event": {
    "type": "MAIN_ADVANCED",
    "source": "verified_origin_main_sha_transition",
    "dedup_key": [
      "repo",
      "main_sha",
      "branch"
    ],
    "fanout": "ACTIVE_AND_IN_REVIEW_TASK_OWNERS_ONLY",
    "coalesce_latest_main_sha": true,
    "notifier_enabled": false,
    "dispatcher_enabled": false,
    "watcher_enabled": false
  },
  "planner": {
    "path": "tools/vx_team_git_reconciliation.py",
    "mode": "READ_ONLY_NO_GIT_WRITES",
    "inputs": [
      "repo",
      "previous_main_sha",
      "current_main_sha",
      "tasks[]"
    ],
    "outputs": [
      "event",
      "reconcile_tasks",
      "blocked"
    ],
    "runtime_dispatch": false
  },
  "executor": {
    "enabled": false,
    "required_steps": [
      "WAIT_SAFEPOINT",
      "VERIFY_BRANCH_OWNER_AND_WORKTREE",
      "VERIFY_ORIGIN_MAIN_TIP",
      "MERGE_OWN_BRANCH_WITH_MAIN",
      "TARGETED_TESTS",
      "INDEPENDENT_REVIEW",
      "RECORD_RECONCILED_SHA",
      "RESUME"
    ],
    "forbid": [
      "AUTO_STASH",
      "RESET_HARD",
      "FORCE_PUSH",
      "UNREVIEWED_CONFLICT_RESOLUTION",
      "MERGE_TO_MAIN_WITHOUT_CI",
      "MUTATE_KILO_RUNTIME"
    ],
    "blocked_on_dirty_worktree": true,
    "blocked_on_conflict": true,
    "blocked_on_permission_denial": true,
    "operator_approval_required": true
  },
  "closure": {
    "merge_to_main": "PR_AFTER_CI_AND_REVIEW",
    "remote_verification_required": true,
    "archive_before_deletion": true,
    "delete_only_owned_task_branch": true,
    "other_active_branches_reconcile_after_merge": true
  },
  "tests": {
    "existing_suite": "tests/test_vx_dev_team_consolidation_v1.py",
    "action": "UPDATE_EXISTING_TEST_SUITE",
    "new_duplicate_test_suite": false,
    "coverage": [
      "OBSERVED_MAIN_ADVANCED",
      "NO_FETCH_NO_PUSH",
      "UNVERIFIED_ANCESTRY_BLOCK",
      "DIVERGENT_MAIN_BLOCK",
      "INVALID_ORIGIN_BLOCK",
      "QUEUE_IDEMPOTENCE",
      "QUEUE_COALESCE_NEWER_SHA",
      "IN_FLIGHT_PAUSE",
      "OWNER_CHANGE_BLOCK",
      "CROSS_REPO_ISOLATION",
      "STALE_TASK_HOLD",
      "MULTI_WORKTREE_FIXTURE",
      "WORKTREE_ORIGIN_VALIDATION",
      "WORKTREE_PATH_MISMATCH",
      "WORKTREE_DUPLICATE_OWNER",
      "WORKTREE_SHARED_PATH",
      "WORKTREE_LOCKED_STATE",
      "POWER_INTERRUPTION_HOLD",
      "RECOVERY_IDEMPOTENCE",
      "RECOVERY_INVALID_QUEUE_REJECTED",
      "REPLACED_WORKTREE_REPOSITORY_REJECTED"
    ]
  },
  "authorization": {
    "no_acl_expansion": true,
    "no_scheduler_activation": true,
    "no_kilo_jsonc_change": true,
    "no_host_mutations": true,
    "operator_approval": false
  },
  "observer": {
    "path": "tools/vx_team_git_reconciliation.py",
    "mode": "ON_DEMAND_READ_ONLY",
    "trigger": "EXPLICIT_CLI_ONLY",
    "uses": [
      "git remote get-url",
      "git ls-remote",
      "git cat-file",
      "git merge-base --is-ancestor"
    ],
    "no_fetch": true,
    "no_merge": true,
    "no_branch_mutation": true,
    "fail_closed_if_ancestry_not_local": true,
    "watcher_enabled": false,
    "main_advance_required_for_queue": true
  },
  "queue": {
    "mode": "PURE_COALESCE_PLAN_ONLY",
    "coalescer": "coalesce_pending_queue",
    "merge_key": [
      "repo",
      "branch"
    ],
    "dedup_event_id": [
      "repo",
      "main_sha",
      "branch"
    ],
    "newest_source": "MAIN_ADVANCED_VERIFIED_ONLY",
    "coalesce_pending_only": true,
    "hold_in_flight_or_missing_task": true,
    "persistence": "NOT_IMPLEMENTED",
    "dispatch": "NOT_IMPLEMENTED",
    "mutation_performed": false
  },
  "inventory": {
    "path": "tools/vx_team_git_worktrees.py",
    "mode": "ON_DEMAND_READ_ONLY",
    "reads": [
      "git remote get-url origin",
      "git worktree list --porcelain -z",
      "private_task_catalog_json",
      "git rev-parse --path-format=absolute --git-common-dir",
      "git symbolic-ref --quiet HEAD",
      "git rev-parse --show-toplevel"
    ],
    "uses_exact_origin": true,
    "returns_private_paths": false,
    "verify_worktree_branch_and_path": true,
    "one_owner_per_branch": true,
    "one_writer_per_worktree": true,
    "agent_identity_authenticated": false,
    "worktree_cleanliness_checked": false,
    "runtime_tool_permissions_checked": false,
    "can_dispatch": false,
    "host_installation": false,
    "verify_live_git_common_dir_and_branch": true
  },
  "recovery": {
    "path": "tools/vx_team_git_worktrees.py",
    "mode": "PURE_PLAN_ONLY",
    "procedure": "plan_interruption_recovery",
    "on_restart": "HOLD_RECHECK_ALL_PENDING_AND_IN_FLIGHT",
    "requires_fresh_git_and_owner_evidence": true,
    "persistent_storage": "NOT_IMPLEMENTED",
    "scheduler_enabled": false,
    "no_dispatch": true,
    "no_mutations": true
  }
}
