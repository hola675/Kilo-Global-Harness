{
  "schema": "vx-agent-registry/1",
  "version": "4.3.0",
  "global_only": true,
  "runtime": "kilo-native",
  "source_policy": "origin-authored-vx-no-external-agent-code",
  "execution": {
    "mode_default": "strict",
    "max_parallel_readers": 3,
    "max_writers": 1,
    "parallel_write_mode": "requires-explicit-opt-in",
    "persistent_branch": "main",
    "temporary_branch_prefix": "work/",
    "task_runner": "kilo-task",
    "worktree_runner": "kilo-agent-manager",
    "message_bus": "kilo-swarm",
    "no_remote_actions_on_selection": true,
    "builder_selection": "opt-in-via-selector-UsarBuildersVX",
    "builders_in_agent_picker": true,
    "all_builder_writes_require_Kilo_ask": true,
    "approval_unavailable_in_noninteractive_task": "BLOCK_AND_RETURN_PLAN",
    "dev_team_primary": "vx-dev-team",
    "dev_team_display_name": "vx-dev-team",
    "dev_team_runtime": "active-v1",
    "capability_handoff_manifest": "registry/vx-team-capability-handoffs-v1.json",
    "capability_handoff_mode": "SOURCE_PLAN_ONLY_NOT_DISPATCHED",
    "bounded_code_builders": [
      "vx-frontend-builder",
      "vx-backend-builder",
      "vx-data-builder",
      "vx-qa-builder",
      "vx-docs-builder",
      "vx-editorial-builder"
    ],
    "ask_only_file_creation_tools": [
      "edit",
      "write",
      "apply_patch"
    ],
    "runtime_write_permission_validation": "NOT_VERIFIED",
    "editorial_style_skill": "vx-editorial-claridad",
    "editorial_leader": "vx-dev-team",
    "editorial_visible_as_independent_mode": false,
    "editorial_task_delegation_source_only": true,
    "unified_pack_manifest": "registry/vx-unified-pack-v1.json",
    "unified_pack_source_candidate": true,
    "visible_pack_leader": "vx-dev-team"
  },
  "agents": [
