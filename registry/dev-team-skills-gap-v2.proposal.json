{
  "schema": "dev-team-skills-gap/2",
  "version": "2.0.0-proposal",
  "status": "SOURCE_READY_RUNTIME_INACTIVE",
  "created": "2026-11-19",
  "base_pack": {
    "skills": 18,
    "runtime_status": "unchanged",
    "note": "No modifica ni sustituye el pack V1 activo/candidato."
  },
  "objective": "Rellenar huecos procedimentales confirmados sin duplicar las 18 skills V1 ni ampliar permisos.",
  "design_rules": [
    "Una responsabilidad principal por skill.",
    "Advisory/read-only para especialistas.",
    "Sin allowed-tools, shell embebido ni scripts.",
    "No modifica kilo.jsonc, MCP, task, edit, write, bash ni depth.",
    "No activar hasta ejecutar evals positivos/negativos y recertificación dirigida."
  ],
  "research_basis": {
    "principles": [
      "Crear skills desde fallos o huecos medibles, no por volumen.",
      "Mantener descripciones cortas y específicas para reducir false positives.",
      "Separar workflows con triggers y criterios de éxito distintos.",
      "Definir éxito y evals antes de confiar en triggering automático.",
      "Para release/incident/performance exigir evidencia, baseline y estados explícitos."
    ],
    "sources": [
      "https://platform.claude.com/docs/en/agents-and-tools/agent-skills/best-practices",
      "https://developers.openai.com/blog/eval-skills",
      "https://developers.openai.com/plugins/build/skills",
      "https://www.anthropic.com/research/equipping-agents-for-the-real-world-with-agent-skills",
      "https://sre.google/",
      "https://opentelemetry.io/docs/concepts/observability-primer/",
      "https://docs.github.com/en/actions/deployment/about-deployments/deploying-with-github-actions",
      "https://docs.aws.amazon.com/wellarchitected/latest/framework/perf_data_collect_record_data_store_performance_metrics.html"
    ]
  },
  "additions": [
    {
      "id": "vx-dev-requirements-acceptance",
      "category": "requirements",
      "agents": [
        "vx-dev-team",
        "vx-dev-quality"
      ],
      "fills": "Ambigüedad y criterios de aceptación antes de test strategy."
    },
    {
      "id": "vx-dev-release-readiness",
      "category": "release",
      "agents": [
        "vx-dev-team",
        "vx-dev-platform",
        "vx-dev-reviewer"
      ],
      "fills": "Gate explícito de release separado del análisis de delivery."
    },
    {
      "id": "vx-dev-observability-privacy",
      "category": "observability",
      "agents": [
        "vx-dev-platform",
        "vx-dev-security"
      ],
      "fills": "Señales operativas con minimización de datos y privacidad."
    },
    {
      "id": "vx-dev-performance-analysis",
      "category": "performance",
      "agents": [
        "vx-dev-quality",
        "vx-dev-platform"
      ],
      "fills": "Baseline, métricas y criterio de regresión sin ejecutar benchmarks."
    },
    {
      "id": "vx-dev-sql-performance",
      "category": "data-performance",
      "agents": [
        "vx-dev-data"
      ],
      "fills": "Queries, planes, índices, waits y patrones de acceso."
    },
    {
      "id": "vx-dev-doc-traceability",
      "category": "traceability",
      "agents": [
        "vx-dev-research",
        "vx-dev-reviewer"
      ],
      "fills": "Cadena requisito→decisión→código→prueba→documentación."
    },
    {
      "id": "vx-dev-regression-analysis",
      "category": "regression",
      "agents": [
        "vx-dev-quality",
        "vx-dev-reviewer"
      ],
      "fills": "Superficie de regresión de un cambio, distinta de estrategia global de pruebas."
    },
    {
      "id": "vx-dev-task-dependency-planning",
      "category": "planning",
      "agents": [
        "vx-dev-team",
