{
  "schema": "dev-team-mcp-readonly-matrix/1",
  "version": "1.0.0-proposal",
  "status": "PROPOSAL_ONLY_NOT_ACTIVE",
  "baseline": "2.0.2-runtime-adaptive",
  "activation": {
    "enabled": false,
    "modifies_agents": false,
    "modifies_kilo_jsonc": false,
    "modifies_mcp_servers": false,
    "note": "Esta matriz clasifica y propone ACL. No concede permisos efectivos."
  },
  "policy": {
    "fallback": "DENY",
    "unknown": "DENY",
    "mixed_tool": "DENY",
    "exact_tool_names_required": true,
    "runtime_snapshot_required_before_activation": true,
    "permission_key_pattern": "<server-id>_<tool-name>",
    "sensitive_reads_require_explicit_review": true,
    "mutations_forbidden_in_readonly_phase": true
  },
  "classes": {
    "READ_SAFE": "Consulta sin mutación y sin datos privados esperados.",
    "READ_SENSITIVE": "Consulta no mutable que puede exponer código privado, telemetría, identidad, sesiones o datos de cuenta.",
    "READ_EXTERNAL_PROCESSING": "Consulta no mutable que envía/analiza datos mediante un servicio externo o puede tener coste.",
    "MUTABLE": "Cambia estado local/remoto, archivos, índices, memoria, navegador o datos.",
    "DESTRUCTIVE_ADMIN": "Borra, despliega, autentica, cambia infraestructura o ejecuta acciones administrativas.",
    "MIXED": "Una misma tool puede leer o mutar según argumentos/endpoint/código.",
    "UNKNOWN": "Semántica o superficie efectiva no verificada para la versión/runtime actual."
  },
  "waves": [
    {
      "id": "WAVE-1-DOCS",
      "status": "PROPOSED",
