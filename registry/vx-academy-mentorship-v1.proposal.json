{
  "schema": "vx-academy-mentorship-policy/1",
  "version": "0.1.0-draft",
  "status": "DESIGN_ONLY_DO_NOT_LOAD_OR_INSTALL",
  "date": "2026-11-15",
  "decision": "VX-D23_PROPOSED",
  "dependencies": [
    "VX-D14",
    "VX-D19",
    "VX-D20",
    "VX-D21",
    "VX-D22"
  ],
  "references": {
    "catalog": "registry/vx-academy-catalog-v1.proposal.json",
    "personnel": "registry/vx-organization-graph-v1.proposal.json",
    "documentation": "docs/VX-ACADEMY-MENTORIA-EVOLUCION-V1-20261115.md"
  },
  "constraints": {
    "scope": "VX_OWNED_AGENTS_SKILLS_ONLY",
    "active": false,
    "auto_training": false,
    "auto_grant_tools": false,
    "auto_modify_agent": false,
    "auto_publish": false,
    "auto_promote": false,
    "auto_create_department": false,
    "allow_agent_self_certification": false,
    "allow_teacher_as_sole_evaluator": false,
    "allow_unverified_expertise_as_certified": false,
    "allow_evaluation_data_for_training": false,
    "allow_private_project_content_in_records": false,
    "allow_unverified_skill_to_be_installed": false,
    "restore_or_revert_requires_verified_backup": true,
    "approval_granted": false,
    "apply_supported": false,
    "scheduler_enabled": false,
    "agent_models_updated": false,
    "current_home_written": false,
    "reviewer_independence_required": true,
    "role_permissions_inherit_from_curriculum": false,
    "teaching_sends_tools_or_secrets": false
  },
  "mentor_selection": {
    "same_capability_independently_verified": true,
    "teaching_competence_independently_verified": true,
    "training_material_audited": true,
    "active_version_tracked": true,
    "conflict_of_interest_check": true,
    "workload_and_task_context_checked": true,
    "missing_qualified_mentor": "MENTOR_NO_DISPONIBLE_USE_REVIEWED_MATERIAL_WITH_HUMAN_OVERSIGHT",
    "seniority_sufficient": false
  },
  "instruction_policy": {
    "personalization_only_after_approval": true,
    "scope": "minimal_role_and_task_relevant",
    "full_skill_loaded_on_demand": true,
    "curricula_not_permission_config": true,
    "skill_pool_is_not_access_control": true
  },
  "stages": [
    {
      "id": "G0",
      "name": "BRECHA_DETECTADA",
      "input": "task_and_claim",
      "guard": "actual_deficit_vs_missing_install_permission_context",
      "output": "diagnosis_candidate",
      "can_change_runtime": false
    },
    {
      "id": "G1",
      "name": "BASELINE_EVALUADO",
      "input": "independent_suite_result",
      "guard": "versioned_holdout_and_runner_provenance",
      "output": "baseline_ref_or_NO_MEDIDO",
      "can_change_runtime": false
    },
    {
      "id": "G2",
      "name": "PLAN_PROPUESTO",
      "input": "minimum_curriculum_candidate",
      "guard": "material_provenance_and_no_permit_elevation",
      "output": "reviewable_plan",
      "can_change_runtime": false
    },
    {
      "id": "G3",
      "name": "MENTOR_ELEGIBLE_O_MATERIAL_AUDITADO",
      "input": "mentor_qualification_or_reviewed_material",
      "guard": "mentor_not_assumed_certified",
      "output": "lesson_plan",
      "can_change_runtime": false
    },
    {
      "id": "G4",
      "name": "ENSAYO_AISLADO",
      "input": "approved_synthetic_case",
      "guard": "fixture_home_worktree_only_no_secrets",
      "output": "lesson_record_declared_or_verified",
      "can_change_runtime": false
    },
    {
      "id": "G5",
      "name": "TRANSFERENCIA_EVALUADA",
      "input": "independent_holdout_suite",
      "guard": "reviewer_not_mentor_author_or_learner",
      "output": "assessment_with_regressions",
      "can_change_runtime": false
    },
    {
      "id": "G6",
      "name": "CAMBIO_VX_CANDIDATO",
      "input": "independent_positive_evidence",
      "guard": "real_compare_without_regression_version_pin",
      "output": "proposal_not_publication",
      "can_change_runtime": false
    },
    {
      "id": "G7",
      "name": "PUBLICACION",
      "input": "authenticated_authorization_and_verified_rollback",
      "guard": "V4_7_SECURITY_NOT_READY",
      "output": "BLOCKED",
      "can_change_runtime": false
    }
  ],
  "states": {
    "plan": [
      "DETECTADO",
      "EVALUACION_PENDIENTE",
      "PLAN_PROPUESTO",
      "REVISION_OPERADOR",
      "AUTORIZADO_EN_AISLADO",
      "ENSAYADO",
      "TRANSFERENCIA_EVALUADA",
      "EVIDENCIA_VERIFICADA",
      "CANDIDATO_DE_VERSION",
      "BLOQUEADO",
      "DESCARTADO",
      "NECESITA_REEVALUACION"
    ],
    "mentoring": [
      "MENTOR_NO_DISPONIBLE",
      "MATERIAL_AUDITADO",
      "MENTORIA_CANDIDATA",
      "MENTORIA_VERIFICADA"
    ],
    "personnel": [
      "SIN_EVALUAR",
      "EVIDENCIA_INSUFICIENTE",
      "COMPETENCIA_VERIFICADA",
      "NECESITA_REEVALUACION"
    ]
  },
  "event_requirements": {
    "required_for_evaluation": [
      "run_ref",
      "suite_version",
      "case_ids_non_sensitive",
      "agent_id",
      "capability_id",
      "agent_version",
      "skill_version_or_null",
      "model_version_or_unknown",
      "runtime_version_or_unknown",
      "reviewer_id",
      "reviewer_separation_verdict",
      "artifact_hash_or_null",
      "outcome",
      "source_kind"
    ],
    "prohibited_fields": [
      "prompt",
      "chat_transcript",
      "client_code",
      "secret",
      "raw_token",
      "client_path",
      "customer_personal_data",
      "auth_payload"
    ],
    "source_kinds": [
      "SELF_DECLARED",
      "RUNNER_VERIFIED",
      "INDEPENDENTLY_REVIEWED"
    ],
    "promotion_requires_independent_review": true,
    "teaching_requires_verified_transfer": true
  },
  "illustrative_plan_not_an_actual_assignment": {
    "is_example_only": true,
    "agent_id": "vx-test-analyst",
    "display_name": "Rafael",
    "capability_id": "qa.negative-cases",
    "mentor_agent_id": null,
    "mentor_status": "MENTOR_NO_DISPONIBLE",
    "reviewer_agent_id": null,
    "reviewer_status": "PENDING_INDEPENDENT_REVIEWER",
    "material": "SYNTHETIC_REVIEWED_MATERIAL_PENDING",
    "baseline": "NO_MEDIDO",
    "training_result": "NOT_EXECUTED",
    "evaluation_result": "NOT_EXECUTED",
    "change_allowed": false
  },
  "records": {
    "training_plans": [],
    "learning_sessions": [],
    "skill_changes": [],
    "evaluation_runs": [],
    "mentorships": [],
    "teaching_qualifications": [],
    "promotion_proposals": [],
    "department_proposals": []
  },
  "metrics": {
    "improvement": "NO_MEDIDO",
    "transfer": "NO_MEDIDO",
    "regressions": "NO_MEDIDO",
    "latency": "NO_MEDIDO",
    "token_use": "NO_MEDIDO",
    "additional_tool_cost": "NO_MEDIDO"
  },
  "pilots": [
    {
      "id": "P0",
      "title": "Design-schema and source reconciliation",
      "status": "PROPOSED",
      "writes_real_home": false
    },
    {
      "id": "P1",
      "title": "Single-capability synthetic baseline",
      "status": "PROPOSED",
      "writes_real_home": false
    },
    {
      "id": "P2",
      "title": "Versioned teaching content AB in isolated fixtures",
      "status": "PROPOSED",
      "writes_real_home": false
    },
    {
      "id": "P3",
      "title": "Independent holdout and regression review",
      "status": "PROPOSED",
      "writes_real_home": false
    },
    {
      "id": "P4",
      "title": "Versioned candidate only; no global apply",
      "status": "PROPOSED",
      "writes_real_home": false
    }
  ],
  "validation_must_enforce": [
    "no_unknown_agent_or_capability",
    "no_self_certification",
    "no_mentor_as_sole_reviewer",
    "no_cycles_in_prerequisites_or_reporting",
    "no_real_training_without_independently_reviewed_baseline",
    "no_publication_without_authenticated_human_approval",
    "no_privilege_inheritance_from_roles_or_learning",
    "no_external_assets_to_manage"
  ]
}
