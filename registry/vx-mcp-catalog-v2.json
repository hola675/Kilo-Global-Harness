  "servers": [
    {
      "id": "codebase-memory",
      "status": "connected-and-validated",
      "transport": "local-stdio",
      "description": "Grafo persistente y memoria estructural del codebase: arquitectura, búsqueda, impacto, trazas y ADR.",
      "source": "https://github.com/DeusData/codebase-memory-mcp",
      "observed_version": "0.12.1",
      "dependencies": [
        "Windows x64",
        "GitHub CLI recomendado para instalación reproducible"
      ],
      "install": {
        "kind": "native-binary",
        "windows": "Descargar release Windows x86_64 y ejecutar install.ps1 --skip-config; destino recomendado %LOCALAPPDATA%\\Programs\\codebase-memory-mcp"
      },
      "kilo": {
        "command": [
          "%LOCALAPPDATA%\\Programs\\codebase-memory-mcp\\codebase-memory-mcp.exe"
        ],
        "timeout_ms": 30000
      },
      "auth": "none",
      "risk": "local-source-code-index-and-persistent-graph"
    },
    {
      "id": "ida",
      "status": "connected-and-validated",
      "transport": "local-stdio",
      "description": "Servidor MCP oficial de Hex-Rays para análisis de IDA, funciones, xrefs, pseudocódigo y sesiones GUI/headless.",
      "source": "https://github.com/HexRaysSA/ida-mcp",
      "observed_version": "20261028.0.3",
      "dependencies": [
        "uv/uvx",
        "IDA Pro >= 9.4",
        "Python >= 3.11 dentro de IDA para plugin GUI"
      ],
      "install": {
        "kind": "uvx-plus-ida-plugin",
        "windows": "uvx ida-hcli plugin install ida-mcp@https://github.com/HexRaysSA/ida-mcp (plugin GUI, condicional); runtime MCP vía uvx ida-mcp"
      },
      "kilo": {
        "command": [
          "uvx",
          "--exclude-newer=1s",
          "ida-mcp",
          "stdio",
          "--agent=kilo-desktop"
        ],
        "timeout_ms": 60000
      },
      "auth": "local-ida-license",
      "risk": "binary-and-idb-access-tools-can-modify-analysis-database"
    },
