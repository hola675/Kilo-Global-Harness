    {
      "id": "github",
      "status": "connected-and-validated",
      "transport": "local-stdio",
      "description": "Repositorios, ramas, commits, issues, pull requests y GitHub Actions usando el servidor MCP oficial.",
      "source": "https://github.com/github/github-mcp-server",
      "observed_version": "2.2.0",
