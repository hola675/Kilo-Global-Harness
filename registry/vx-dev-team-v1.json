      "team-lead",
      "technical-lead",
      "integrator"
    ],
    "writes": true,
    "max_writers_per_worktree": 1,
    "displayName": "vx-dev-team",
    "color": "#8B5CF6",
    "visual_strategy": "displayName-plus-color",
    "custom_icon_field_supported": false
  },
  "phases": [
    "INTAKE",
    "DISCOVER",
    "PLAN",
    "DESIGN_CONTRACT",
    "BUILD",
    "VERIFY",
    "REVIEW",
    "INTEGRATE",
    "RELEASE_GATE",
    "CLOSE"
