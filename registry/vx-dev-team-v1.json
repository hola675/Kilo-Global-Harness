    }
  ],
  "execution_policy": {
    "max_parallel_readers": 3,
    "max_writers_per_worktree": 1,
    "builder_task_noninteractive_rule": "if write permission requires ask, return BLOCKED_FOR_WRITE_APPROVAL or implementation handoff; never bypass host approval",
    "merge_requires_review": true,
    "production_requires_human_authorization": true
  },
  "next_phase": "tool-level-mcp-acl-refinement-after-runtime-smoke",
  "activation": {
    "source_file": "agents/vx-dev-team.md",
