  "core_roles": [
    {
      "id": "research-engineer",
      "agent": "vx-researcher",
      "kind": "reader",
      "phase": [
        "DISCOVER",
        "PLAN"
      ]
    },
    {
      "id": "frontend-engineer",
      "agent": "vx-frontend-builder",
      "kind": "implementation",
      "phase": [
        "BUILD"
      ]
    },
    {
      "id": "backend-engineer",
      "agent": "vx-backend-builder",
      "kind": "implementation",
      "phase": [
        "BUILD"
      ]
    },
    {
      "id": "data-engineer",
      "agent": "vx-data-builder",
      "kind": "implementation-conditional",
      "phase": [
        "DESIGN_CONTRACT",
        "BUILD"
      ]
    },
    {
      "id": "qa-analyst",
      "agent": "vx-test-analyst",
      "kind": "reader",
      "phase": [
        "PLAN",
        "VERIFY"
      ]
    },
    {
      "id": "qa-engineer",
      "agent": "vx-qa-builder",
      "kind": "implementation",
      "phase": [
        "VERIFY"
      ]
    },
    {
      "id": "code-reviewer",
      "agent": "vx-inspector",
      "kind": "reader",
      "phase": [
        "REVIEW"
      ]
    },
    {
      "id": "security-reviewer",
      "agent": "vx-security-reviewer",
      "kind": "reader",
      "phase": [
        "DISCOVER",
        "REVIEW"
      ]
    }
